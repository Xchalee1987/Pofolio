<body class="index-page">
  <%- include("loginNav.ejs"); %>

  <main class="main">

    <!-- User list Section -->
    <section id="about" class="about section">
        
    <!-- Section Title -->
      <div class="container section-title history-title" data-aos="fade-up">
        <h2>รายชื่อผู้ใช้งาน</h2>
      </div><!-- End Section Title -->

      <div class="user-item-list-container">
        <% if (locals.users) { %>
            <% users.forEach(function(user) { %>
                <div class="user-list-item">
                    <p>Username: <%= user.username %> (User ID: <%= user.user_id %>)</p>
                    <p>Total transaction: <%= user.totalTransaction %></p>
                    <button type="submit" data-user-id="<%= user.user_id %>" class="del-user delete-button">Delete</button>
                </div>
            <% }) %>
        <% } else { %>
            <p>ไม่มีผู้ใช้</p>
        <% } %>
      </div>

    </section><!-- User list Section -->

  </main>   

