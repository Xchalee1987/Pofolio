<body class="index-page">
  <%- include("loginNav.ejs"); %>

  <main class="main">

    <!-- Purchase history Section -->
    <section id="about" class="about section">
        
    <!-- Section Title -->
      <div class="container section-title history-title" data-aos="fade-up">
        <h2>ประวัติการสั่งซื้อ</h2>
      </div><!-- End Section Title -->

      <div class="history-container" id="history-list">
        <% ts.forEach(t => { %>
          <div class="history-item">
            <hr>
              <div>
                <% if (u.role === 'admin') { %>
                <button class="delTransactionBtn" data-transaction-id="<%= t.trans_id %>">Delete</button>
                <% } %>
                <span>
                  Transaction ID <%= t.trans_id %>
                  <% if (u.role === 'admin') { %>
                   | by <%= t.username %> (User ID: <%= t.user_id %>)
                  <% } %>
                </span>
                <span>Concert Name: <%= t.title %></span>
                <span>Zone Name: <%= t.zone_name %></span>
                <span>Seat Number: <%= t.seat_number %></span>
                <span>Price: <%= t.base_price %></span>
                <span><%= t.formatted_purchase_date %></span>
              </div>
            <hr>
          </div>
        <% }); %>

      </div>

    </section><!-- Purchase history Section -->

  </main>   

  <footer id="footer" class="footer accent-background">

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename">Impact</strong> <span>All Rights Reserved</span></p>
      <div class="credits">
        <!-- All the links in the footer should remain intact. -->
