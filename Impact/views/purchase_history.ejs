  <script>
    const userRole = "<%= u.role %>"; // role ที่ส่งมาจาก app
    const historyList = document.getElementById('history-list');

    async function fetchTransaction() {
        const response = await fetch('/fetchTransactions');
        const transactions = await response.json(); //jsonที่ถูกส่งมาจาก app fetchTransactions
        historyList.innerHTML = '';
        transactions.forEach(transaction => {
            const transactionDiv = document.createElement('div');
            transactionDiv.classList.add('history-item');
            if (userRole === 'admin') {
              transactionDiv.innerHTML += `
              <hr>
              <div>
                <button onclick="deleteTransaction(${transaction.trans_id})">Delete</button>
                <span>Transaction ID ${transaction.trans_id} | by ${transaction.username} (User ID: ${transaction.user_id})</span>
                <span>Concert Name: ${transaction.title}</span>
                <span>Zone Name: ${transaction.zone_name}</span>
                <span>Seat Number: ${transaction.seat_number}</span>
                <span>Price: ${transaction.base_price}</span>
                <span>${transaction.formatted_purchase_date}</span>
              </div>
              <hr>
              `;}
              else {
                transactionDiv.innerHTML = `
              <hr>
              <div>
                <span>Transaction ID ${transaction.trans_id}</span>
                <span>Concert Name: ${transaction.title}</span>
                <span>Zone Name: ${transaction.zone_name}</span>
                <span>Seat Number: ${transaction.seat_number}</span>
                <span>Price: ${transaction.base_price}</span>
                <span>${transaction.formatted_purchase_date}</span>
              </div>
              <hr>
                `;
              }

            historyList.appendChild(transactionDiv);
        });
    }
    
    async function deleteTransaction(id) {
      if (confirm(`Are you sure to delete [Trans ID: ${id}] transaction?`)) {
        const res = await fetch(`/admin/delete/${id}`, { method: 'DELETE' });
        if (res.ok) {
          alert('Transaction deleted');
          fetchTransaction();
        } else {
          alert('Failed to delete transaction');
        }
      }
    }


    fetchTransaction();
  </script>

