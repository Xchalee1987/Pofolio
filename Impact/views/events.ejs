<body class="service-details-page">

<%- include("loginNav.ejs"); %>

  <main class="main">
        <div class="max-w-6xl mx-auto p-4 md:p-8">
        
            <!-- Main layout container: uses flexbox -->
            <!-- Stacks on mobile (flex-col) and becomes a row on medium screens (md:flex-row) -->
            <div class="flex flex-col md:flex-row gap-6">

                <!-- Left Column: Item List (Wider) -->
                <!-- Takes full width on mobile, and 1/2 width on desktop (md:w-1/2) -->
                <div class="w-full md:w-1/2">
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h2 class="text-2xl font-semibold mb-4 text-gray-800">Item List</h2>
                        
                        <!-- Item List Container -->
                        <div class="space-y-3">
                            <!-- Placeholder List Items -->
                            <div class="list-item">
                                <span>Item One</span>
                                <span class="text-sm text-gray-500">Details...</span>
                            </div>
                            <div class="list-item">
                                <span>Item Two</span>
                                <span class="text-sm text-gray-500">Details...</span>
                            </div>
                            <div class="list-item">
                                <span>Item Three</span>
                                <span class="text-sm text-gray-500">Details...</span>
                            </div>
                            <div class="list-item">
                                <span>Item Four</span>
                                <span class="text-sm text-gray-500">Details...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Form (Narrower) -->
                <!-- Takes full width on mobile, and 1/2 width on desktop (md:w-1/2) -->
                <div class="w-full md:w-1/2">
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h2 class="text-2xl font-semibold mb-4 text-gray-800">Add New Item</h2>
                        
                        <!-- Simple Form -->
                        <form action="#" method="POST">
                            <div class="space-y-4">
                                <!-- Form Field: Item Name -->
                                <div>
                                    <label for="item_name" class="block text-sm font-medium text-gray-700">Item Name</label>
                                    <input type="text" id="item_name" name="item_name" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                                </div>

                                <!-- Form Field: Description -->
                                <div>
                                    <label for="description" class="block text-sm font-medium text-gray-700">Description</label>
                                    <textarea id="description" name="description" rows="3" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"></textarea>
                                </div>

                                <!-- Submit Button -->
                                <div>
                                    <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        Submit
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div> <!-- End of flex container -->
            
        </div> <!-- End of main container -->
  

    
  </main>

  
