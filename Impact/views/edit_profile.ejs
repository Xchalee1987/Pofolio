<body class="index-page">

  <%- include('loginNav.ejs') %>

  <main class="main">

    <!-- Purchase history Section -->
    <section id="about" class="about section">
      
      <!-- Section Title -->
      <div class="container section-title history-title" data-aos="fade-up">
        <!-- <h2>edit profile page</h2> -->
      </div>
      <!-- End Section Title -->
      
      <form method="POST" onsubmit="return confirmToSetAction();" id="edit-form" class="profile-container">
        <h2>Profile</h2>
        <span id="updated-msg"></span>
        
        <div class="profile-info">
          <label>ชื่อผู้ใช้ |</label>
          <a href="#" class="editnamebtn">แก้ไขชื่อผู้ใช้</a>
          <a href="#" class="editnamebtn disable" onclick="resetDefault(1)">ยกเลิกแก้ไขชื่อผู้ใช้</a> <!-- ส่งค่า 1 ไปที่ resetDefault --> 
          <input type="text" class="disable" id="input-username" name="inputUsername" value="<%= u.username %>">

          <label>เบอร์โทรศัพท์ |</label>
          <a href="#" class="editphonebtn">แก้ไขเบอร์โทรศัพท์</a>
          <a href="#" class="editphonebtn disable" onclick="resetDefault(2)">ยกเลิกแก้ไขเบอร์โทรศัพท์</a><!-- ส่งค่า 2 ไปที่ resetDefault -->
          <input type="text" class="disable" id="input-phone" name="inputPhone" value="<%= u.phone %>">

          <label class="passwordLabel">กรุณากรอกรหัสผ่านเพื่อแก้ไขข้อมูล</label>
          <label class="passwordLabel disable">กรุณากรอกรหัสผ่านเก่า</label>
          <a href="#" class="editpassbtn">แก้ไขเรหัสผ่าน</a>
          <a href="#" class="editpassbtn disable">ยกเลิกแก้ไขเรหัสผ่าน</a>
          <input type="password" id="input-passwordOld" class="clear-password" name="inputPass">
          <span id="no-password-entered" style="color: red;text-align: center;"></span>

          <label class="passwordLabel disable">กรุณากรอกรหัสผ่านใหม่</label>
          <input type="password" id="input-passwordNew" class="clear-password disable" name="inputPassNew">
        </div>

        <div class="button">
          <button type="submit">ยืนยัน</button>          
        </div>
      </form>

    </section><!-- Purchase history Section -->

  </main>

